# Copy this file to .env.local and fill in the values (see README.md).

# Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...). The older "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# TMDB → Settings → API → "API Read Access Token" (the long one)
TMDB_READ_TOKEN=eyJhbGciOi...

# Shown on the sign-in page, e.g. "tiu.edu.iq"
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=tiu.edu.iq
